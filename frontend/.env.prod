# Variables de entorno para producción
# Este archivo se usa por defecto cuando ejecutas npm run build

# URL del backend API (sin barra al final)
VITE_API_BASE_URL=https://api.expedientes.ciacblp.com

# URL del frontend (para enlaces, redirects, etc.)
VITE_APP_URL=https://expedientes.ciacblp.com

# Configuración de entorno
VITE_NODE_ENV=production

# Debug mode (false en producción)
VITE_DEBUG=false